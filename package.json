{
  "name": "leashguard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A minimal Vite + React + TypeScript QoreChain dApp using @qorechain/sdk to read balances and tokenomics.",
  "scripts": {
    "dev": "vite",
    "build": "npx hardhat compile && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma skills sync || exit 0",
    "db:update": "prisma db update",
    "db:emit": "prisma contract emit",
    "server": "tsx src/server/index.ts",
    "agent": "tsx src/agent/agent.ts",
    "pool": "tsx scripts/pool.ts",
    "pqc:setup": "tsx scripts/pqc-and-window.ts",
    "deploy": "hardhat run scripts/deploy.ts --network qorechainTestnet",
    "qore:status": "qore status",
    "qore:keys": "qore keys list",
    "qore:scaffold": "npx create-qorechain-dapp"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.32.4",
    "@prisma/orm-postgres": "^8.0.0-rc.24",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/qoresign": "^0.2.0",
    "@qorechain/qorex-types": "^0.1.0",
    "@qorechain/react": "^0.14.0",
    "@qorechain/sdk": "^0.14.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "viem": "^2.58.4",
    "wagmi": "^3.7.11"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.2",
    "@nomicfoundation/hardhat-ignition": "^3.1.10",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@prisma/cli-engine": "^0.10.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.7.0",
    "chai": "^6.3.0",
    "ethers": "^6.17.0",
    "forge-std": "github:foundry-rs/forge-std#v1.17.0",
    "hardhat": "^3.22.0",
    "mocha": "^12.0.3",
    "postcss": "^8.5.33",
    "prisma": "^8.0.0-rc.34",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vite": "^5.4.0"
  }
}